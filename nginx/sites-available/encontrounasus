server {
    listen 80;
    server_name encontrounasus.ufjf.br;
    return 301 https://encontrounasus.ufjf.br$request_uri;
}

server {
    listen 443 ssl;
    server_name encontrounasus.ufjf.br;

    ssl_certificate /etc/nginx/ssl/encontrounasus.ufjf.br.crt;
    ssl_certificate_key /etc/nginx/ssl/encontrounasus.ufjf.br.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    access_log /var/log/nginx/access-encontrounasus.log;
    error_log /var/log/nginx/error-encontrounasus.log warn;

    include /etc/nginx/snippets/rules/common.conf;

    location / {
        proxy_pass http://127.0.0.1:8070;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
